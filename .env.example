# ─── Core LLM ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ─── Telegram Bot ─────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ALLOWED_CHAT_IDS=123456789,987654321   # comma-separated chat IDs

# ─── Google / Gmail + Calendar ───────────────────────────────────────────────
# IMPORTANT: keep these files OUTSIDE the repo directory.
# Download your OAuth2 client secret from Google Cloud Console and save it to
# a path like ~/.config/merv/google_credentials.json — never inside the repo.
# The token file is auto-generated on first OAuth login; store it equally safely.
GOOGLE_CREDENTIALS_FILE=~/.config/merv/google_credentials.json
GOOGLE_TOKEN_FILE=~/.config/merv/google_token.json
# Calendar IDs (comma-separated if multiple)
GOOGLE_CALENDAR_IDS=primary,family_calendar_id@group.calendar.google.com

# ─── Family Profile ───────────────────────────────────────────────────────────
FAMILY_TIMEZONE=America/New_York
FAMILY_MEMBERS=Dad,Mom,Henry,<sibling>
HENRY_SCHEDULE_CONSTRAINTS=no_early_morning_appts,no_school_hours
RAIN_OUT_SPORTS=soccer,baseball,lacrosse

# ─── Morning Routine ──────────────────────────────────────────────────────────
MORNING_ROUTINE_HOUR=7
MORNING_ROUTINE_MINUTE=0
MORNING_ROUTINE_CHAT_ID=123456789   # Telegram chat to send morning brief

# ─── Memory / Persistence ────────────────────────────────────────────────────
MERV_DATA_DIR=~/.config/merv/data
MERV_MEMORY_FILE=~/.config/merv/data/memory.json

# ─── Voice (Phase 2 placeholder) ─────────────────────────────────────────────
VOICE_ENABLED=false
VOICE_ENGINE=pyttsx3          # pyttsx3 | elevenlabs | hudson
ELEVENLABS_API_KEY=           # if using ElevenLabs TTS

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json               # json | console

# ─── Environment ─────────────────────────────────────────────────────────────
MERV_ENV=development          # development | production
